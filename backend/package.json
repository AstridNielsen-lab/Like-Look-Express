{
  "name": "like-look-express-backend",
  "version": "1.0.0",
  "description": "Backend API para Like Look Express - Plataforma de Logística Inteligente",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:ts": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.{js,ts}",
    "lint:fix": "eslint src/**/*.{js,ts} --fix",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.0",
    "jsonwebtoken": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "passport-google-oauth20": "^2.0.0",
    "@prisma/client": "^5.7.0",
    "redis": "^4.6.0",
    "nodemailer": "^6.9.0",
    "twilio": "^4.19.0",
    "axios": "^1.6.0",
    "xml2js": "^0.6.0",
    "multer": "^1.4.0",
    "sharp": "^0.33.0",
    "pdfkit": "^0.14.0",
    "xlsx": "^0.18.0",
    "moment": "^2.29.0",
    "moment-timezone": "^0.5.0",
    "cron": "^3.1.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.0",
    "joi": "^17.11.0",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/morgan": "^1.9.0",
    "@types/compression": "^1.7.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-jwt": "^3.0.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/multer": "^1.4.0",
    "@types/xml2js": "^0.4.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@types/supertest": "^6.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.7.0"
  },
  "prisma": {
    "seed": "ts-node database/seeds/index.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

