{
  "version": 2,
  "name": "like-look-express",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://like-look-express.vercel.app",
    "NODE_ENV": "production"
  },
  "regions": ["gru1"],
  "functions": {
    "frontend/src/app/**": {
      "maxDuration": 30
    }
  }
}

