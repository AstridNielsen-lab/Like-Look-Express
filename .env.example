# =================================
# LIKE LOOK EXPRESS - ENVIRONMENT VARIABLES
# =================================

# Ambiente de execução
NODE_ENV=development

# =================================
# DATABASE CONFIGURATION
# =================================

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/like_look_express?schema=public"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# =================================
# APPLICATION CONFIGURATION
# =================================

# Porta do servidor backend
PORT=3001

# URL base da aplicação
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# =================================
# SECURITY & AUTHENTICATION
# =================================

# JWT Secret (gere uma chave forte em produção)
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Refresh Token Secret
REFRESH_TOKEN_SECRET="your-refresh-token-secret-here"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Encryption key para dados sensíveis
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# =================================
# CORREIOS API INTEGRATION
# =================================

# Configurações da API dos Correios
CORREIOS_API_URL="https://apps.correios.com.br/SigepMasterJPA/AtendeClienteService/AtendeCliente"
CORREIOS_USER="your-correios-user"
CORREIOS_PASSWORD="your-correios-password"
CORREIOS_CARD_NUMBER="your-correios-card-number"
CORREIOS_CONTRACT_NUMBER="your-correios-contract-number"
CORREIOS_ADMINISTRATIVE_CODE="your-correios-admin-code"

# =================================
# GOOGLE SERVICES
# =================================

# Google Maps API
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Google OAuth (se necessário)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# =================================
# EMAIL CONFIGURATION
# =================================

# Configurações SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Configurações de e-mail
EMAIL_FROM="noreply@likelookexpress.com"
EMAIL_FROM_NAME="Like Look Express"

# =================================
# SMS CONFIGURATION (TWILIO)
# =================================

TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# =================================
# PAYMENT GATEWAYS
# =================================

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
MERCADOPAGO_PUBLIC_KEY="your-mercadopago-public-key"

# =================================
# PUSH NOTIFICATIONS
# =================================

# Firebase Cloud Messaging
FCM_SERVER_KEY="your-fcm-server-key"
FCM_SENDER_ID="your-fcm-sender-id"

# =================================
# STORAGE CONFIGURATION
# =================================

# AWS S3 (para arquivos)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="like-look-express-files"

# =================================
# MONITORING & LOGGING
# =================================

# Sentry (monitoramento de erros)
SENTRY_DSN="your-sentry-dsn"

# Log Level
LOG_LEVEL="info"

# =================================
# RATE LIMITING
# =================================

# Rate limit configurações
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100  # máximo de requests por janela

# =================================
# SECURITY HEADERS
# =================================

# CORS configurações
CORS_ORIGIN="http://localhost:3000,https://likelookexpress.com"

# =================================
# DESENVOLVIMENTO E TESTES
# =================================

# Variáveis específicas para desenvolvimento
DEBUG=true
VERBOSE_LOGGING=false

# Database de testes
TEST_DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/like_look_express_test?schema=public"

# =================================
# BACKUP CONFIGURATION
# =================================

# Configurações de backup automático
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Diário às 2:00 AM
BACKUP_RETENTION_DAYS=30

# =================================
# FEATURE FLAGS
# =================================

# Funcionalidades experimentais
ENABLE_2FA=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_CHAT_SUPPORT=false

# =================================
# NOTAS IMPORTANTES
# =================================

# 1. NUNCA commite este arquivo com valores reais em repositórios públicos
# 2. Use o arquivo .env.local para desenvolvimento local
# 3. Em produção, configure as variáveis diretamente no servidor
# 4. Mantenha as chaves de API e senhas seguras
# 5. Use ferramentas como AWS Secrets Manager ou HashiCorp Vault em produção

